# K3-3 神通谱文案（spec §7.6）：键=皮肤 id。KD-5 全量并入；M-S 全量缩短至每段 ≤70 字。
# 缺键回退 "——"。
const DESC := {
	"skin_origin_kaitou": "本相者，万般神通之所自出——初心是也。粗布围裙裹未凿之璞，一手执刨，一手抱梁。围裙旧痕最深处，便是落刨千次之处。",
	"skin_origin_song": "玉尺者，宋人之神理也。素袍玉簪，袖中自有一部《营造法式》。以材为祖，以分为度，举折有数，斗拱有谱，毫厘不欺。佩之，落墨如陈规矩。",
	"skin_origin_yuan": "苍梁者，大木之雄也。毡帽革带，弯刀在腰，敢以巨额承千钧。佩之，胸怀便阔：梁不怕粗，柱不怕壮，凡大材者自有大用，不必削足适履。",
	"skin_origin_ming": "缠枝者，线脚之神也。水墨衣带，当风婉转。巧不在力吼，而在圆熟：边抹起线一气贯通，裹腿做圆不见棱角。佩之，硬木也生出柔意。",
	"skin_origin_xiandai": "衍数者，今之神机也。素衣执扇，扇中参数列列，榫卯纳于其中。古人运斤，今人运算；算至精处，仍要亲手试一眼松紧。扇底之风，来自数千年。",
	"skin_01": "抱节者，雪豹山灵也。怀中竹筒，抱之如抱柱，寒天不放手。竹有节，木有理，榫有卯——节者，木之骨、匠之信也。佩之，最繁难处自有节度。",
	"skin_02": "运斤者，豹童也。红帔小槌，击竹有声，如磬如梆。匠石运斤成风，非力大，是心手相忘。佩之，锤下有准，落点即是墨线，七分力即停。",
	"skin_03": "髹饰者，狸奴也。对镜理奁，奁中是漆，镜里是器。披麻捉灰凡三层，方上漆，一器髹毕千年不腐。佩之，手底过处，凡木皆生光泽。",
	"skin_04": "煨木者，狐女也。掌中一釜，火候在心。欲曲一木，以文火徐煨，趁热就势，曲而不折。佩之，急事能缓，硬处能弯。",
	"skin_05": "津梁者，九尾灵狐也。秉灯立于小桥，桥下花影，桥上灯明。桥是木作的菩萨心：肯弯腰，肯承重。佩之，每逢险处，自有一线可通。",
	"skin_06": "斫轮者，莲上童子也。怀中一轮，徐徐而运。轮扁斫轮，得于手应于心，口不能言——真正的分寸，书上没有，手上有。佩之，愈慢愈准。",
	"skin_07": "牵丝者，荷荡少年也。肩荷白藕，藕丝细如墨线，韧胜胶漆。藕断丝连，丝连者榫之神也：器拆而魂不散。佩之，凡经手处皆续前缘。",
	"skin_08": "烹鲜者，炎童也。一手执串，一手掣火，火在肘腋而不燎眉。治木如烹鲜：文火焙之，猛火攻之，全看该文该猛。佩之，遇燥材知所进退。",
	"skin_09": "执柯者，竹林豹女也。身负行囊，穿篁而过，叶声如雨。伐柯伐柯，其则不远——手中旧器，便是从上一柄学来的。佩之，出手有师承。",
	"skin_10": "夯歌者，瓜田少年也。巨槌在肩，白犬相随，号子一起，落硪处尘土微颤。筑基不打诳语，硪硪都要踩实。佩之，脚下功夫最诚实。",
	"skin_11": "执矩者，顶瓜小童也。方瓜如玺，覆于头上——瓜可方，木亦可方。矩在头顶如在三尺上，心正则线正。佩之，落料最省，横平竖直。",
	"skin_12": "燔芝者，树栖游子也。青焰一簇，慢煨灵芝，白犬守于侧。火候急不得也熄不得，性子焙顺了，木便不翘不裂。佩之，守得住长夜。",
	"skin_13": "磨镜者，卷发夫人也。手摇一磨，碾的是豆，磨的是性子。器面欲光，先磨其心。佩之，凡出手之物，必擦得见影，不留毛茬。",
	"skin_14": "悬河者，执壶夫人也。银膏一倾，如瀑倒悬，分寸全在腕底：多一线则溢，少一线则虚。佩之，倒得了满杯，收得住最后一滴。",
	"skin_15": "白驹者，踏球小马也。蹄下有球，口衔一灯，灯不灭工不停。白驹过隙，千年一瞬，惟榫卯留得住时间。佩之，与光阴相熟，工到自然成。",
	"skin_16": "品泉者，执盏夫人也。啜饮之间，眉目安然。识材如品泉：一眼辨其性，一叩知其声。佩之，不妄用一木，各材各得其所。",
	"skin_17": "踩岁者，骑禽小娘子也。足下灵禽，一路碎响，如踏芝麻秸——碎碎平安，岁岁有今朝。佩之，开工必有彩头，步步落在实处。",
	"skin_18": "梅妆者，新岁贵人也。冠上梅开，鬓边龙影，喜气如披红。器物亦有妆：雕刻一两分，是给它披红挂彩。佩之，最朴素的木料也开出花。",
	"skin_19": "伏枥者，火鬃小马也。卧于书箱之侧，鬃尾犹带余焰。老骥伏枥，歇着不是不走了。新材静置经年方成大器。佩之，知何时该拼，何时该等。",
	"skin_20": "挑灯者，双灯童子也。赤发如焰，两肩挑灯。灯下看墨线，比日头下更直——心静了，线就直了。佩之，长夜有伴，灯不挑自明。",
	"skin_21": "鱼龙者，跨鲤童子也。鱼灯为骑，纸扇为鞭，一夜鱼龙舞。鱼灯骨架不过十几根竹篾，游起来却像活物。佩之，凡举重若轻处，皆是功夫。",
	"skin_22": "向阳者，一株花也。陶盆浅土，终日随日头转身。木性亦然：受光面紧，背光面松——识得向阳处，便识得木脾气。佩之，下刀皆顺纹。",
	"skin_23": "莳花者，蓝铃园丁也。草帽素裙，盆盆罐罐皆是活计。养木如养花：锄轻水匀，移对时辰。佩之，凡经手的物事，都慢慢活泛起来。",
	"skin_24": "星涡者，衔烟斗的画师也。满身漩涡如星河倒卷——连天上的云都长成木纹。瘿木之涡，皆是岁月打的稿子。佩之，粗坯也看得出篇章。",
	"skin_25": "守拙者，画架上一卵也。不着一色，素到极处。大巧若拙——最高的手艺往往像没动手。佩之，肯下笨功夫：可传十年的，只有那一件。",
	"skin_26": "鉴形者，携镜少女也。卵者圆之极，镜者明之极。木匠以目为镜：梁直不直，吊起一望便知。佩之，心明眼亮，歪一分都看不过去。",
	"skin_27": "守藏者，绿窗贵妇也。深坐雕木之阁，掌上明珠覆以琉璃。器物传到今天，靠的不是结实，是有人守。佩之，凡老木旧料，都有了着落。",
	"skin_28": "结庐者，檐下小兽也。草亭一座，糖串一枚，躲在自家屋顶下。捆扎结顶是人类最早的房子——榫卯之前，先有绑扎。佩之，善于白手起家。",
	"skin_29": "绳墨者，帽肆匠人也。软尺一抖，尺寸了然。绳墨是匠人的规矩：曲直自此定，方圆自此分，差半分都要重来。佩之，量人量物皆准。",
	"skin_30": "借景者，伞下夫人也。足下木台，一池睡莲，天光云影不请自来。造园贵在借：借远山，借斜阳。佩之，再小的作坊，也装得下天地。",
	"skin_31": "叠石者，鸣镲小郎也。铜镲一击，石子三叠如小山。叠山讲一个「压」字：石互压而生稳，木互压而生安。佩之，最难缠的局面也摆得平。",
	"skin_32": "穿山者，抱鳞小郎也。怀里金甲穿山兽，穿石如泥。凿卯如穿山：一寸一寸进，不响不噪，到位即停。佩之，再硬的木头也敢下凿。",
	"skin_33": "凿岩者，冠兽小匠也。帽上金兽镇着，石槌起落，顽石让路。基在岩上，屋才立得千年——最风光的梁架都从石缝里长出。佩之，肯做打底功夫。",
	"skin_34": "启函者，破罐雏鸟也。一声脆响，天光灌进罐里——壳外还有天。开榫如启函：封得住才开得出，不破则不明。佩之，遇僵局敢下第一凿。",
	"skin_35": "理匣者，拾贝海娘也。珊瑚贝壳各归各位，一箱虽小，装得下一片海。收工如收箱：工具归位，余料入格。佩之，乱麻到手，三两下理出头绪。",
	"skin_36": "圆光者，水阁鲛后也。端坐圆窗之内，水母替她挑着水晶帘。圆光罩是木作绝活：一木镂空，隔而不断。佩之，凡隔着的、藏着的，都瞒不过。",
	"skin_37": "悬鱼者，袋中金鳞也。碧水一囊，游鱼自在。古人在山墙悬一枚木鱼：水克火，木构最怕火。佩之，出入平安，凡到之处，火烛自敛。",
	"skin_38": "落墨者，踏浪鲛姬也。符卷随身，朱印在侧，衣袂不湿。墨线一弹，百柱归位——纸上画符，木上弹线。佩之，落笔即准，再无返工。",
	"skin_39": "潜渊者，着褂渊童也。立于水底卵石之上，口吐珍珠，呼吸自如。沉得下去才浮得上来：木头含几成水，一摸便知。佩之，愈深愈定。",
	"skin_40": "负笈者，海府书生也。头顶墨玉，怀抱典籍，走一路读一路。书上得来的终究要过手——读万卷，也要斫万木。佩之，图样过目成诵。",
	"skin_41": "横经者，贝阙观书人也。倚珠贝之床，周身明珠低照。手艺有止境，问学无止境。佩之，肯翻旧账：前人的错处与巧处，都记得住。",
	"skin_42": "枕涛者，鲸月少年也。卧于贝床，耳边是一整片海。潮起潮落如千年松涛——木原是海的近亲。佩之，心宽处，木自直。",
}

static func get_skins() -> Array[Dictionary]:
	var list: Array[Dictionary] = []
	# 原创 5 项置顶（K3-4「排最前」），显示名/desc/效果由 NAME/DESC/EFFECT 常量表覆盖
	for s: Dictionary in ORIGIN_SKINS:
		var d: Dictionary = s.duplicate(true)
		var oid: String = String(d["id"])
		d["name"] = String(NAME.get(oid, oid))
		d["desc"] = String(DESC.get(oid, "——"))
		d["effect"] = String(EFFECT.get(oid, ""))  # O7：效果文案合并
		list.append(d)
	# 其后仍为旧 42 项（无 original 字段=可购买，向后兼容）
	for i: int in range(1, SKIN_COUNT + 1):
		var id: String = "skin_%02d" % i
		list.append({
			"id": id,
			"name": String(NAME.get(id, "皮肤 %d" % i)),
			"price": 0 if i <= FREE_COUNT else PRICE_PAID,
			"texture": "res://assets/skins/%s.png" % id,
			"desc": String(DESC.get(id, "——")),
			"effect": String(EFFECT.get(id, "")),  # O7：效果文案合并
		})
	return list

static func get_skin(id: String) -> Dictionary:
	for s: Dictionary in get_skins():
		if s["id"] == id:
			return s
	return {}

static func get_origin_skin(chapter: int) -> Dictionary:
	# 章节→原创皮肤（1..5）；无对应返回 {}。补 name/desc/effect 便于直接消费。
	for s: Dictionary in ORIGIN_SKINS:
		if int(s["unlock_chapter"]) == chapter:
			var d: Dictionary = s.duplicate(true)
			var oid: String = String(d["id"])
			d["name"] = String(NAME.get(oid, oid))
			d["desc"] = String(DESC.get(oid, "——"))
			d["effect"] = String(EFFECT.get(oid, ""))  # O7：效果文案合并
			return d
	return {}

static func is_origin(id: String) -> bool:
	for s: Dictionary in ORIGIN_SKINS:
		if s["id"] == id:
			return true
	return false
